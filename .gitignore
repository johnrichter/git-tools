###############################################################################
# SECRETS — never commit
###############################################################################

# SSH private keys — base names + per-variant <variant>_* + generic forms; .pub kept trackable
id_rsa
id_rsa_*
id_dsa
id_dsa_*
id_ecdsa
id_ecdsa_*
id_ed25519
id_ed25519_*
*_rsa
*_dsa
*_ecdsa
*_ed25519
*.ppk
!*.pub

# Other private-key / cert file types
*.pem
*.key

# TLS / PKCS / keystore key material
*.p12
*.pfx
*.p8
*.jks
*.keystore

# Apple signing material
*.mobileprovision
*.certSigningRequest

# GPG
secring.*

# Environment files — but keep committed examples/templates
.env
.env.*
*.env
.envrc
!.env.example
!.env.sample
!.env.template
!*.env.example
!*.env.sample
!*.env.template
!.envrc.example

# Cloud provider credentials
.aws/
.gcloud/
gcloud-*.json
*-service-account*.json
.azure/

# Generic credential / secret files
.netrc
.git-credentials
credentials
credentials.json
secrets.*
*.secret
.npmrc
.pypirc

