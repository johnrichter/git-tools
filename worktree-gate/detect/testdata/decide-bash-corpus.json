{
  "description": "Decision-layer fixtures for decideBash: SC20's named-path rule (a write-class piece naming a primary-checkout path is denied from any cwd, while a read-class piece naming the same path and the outside-any-repo uncertain class stay allowed) and SC15's digest-verified provisioned-CLI allowance (three verbs, no retarget, keyed on binary identity supplied as argv). The loader builds one fixed hermetic topology per case: primary checkout /repo, linked worktree /repo/wt, provisioned CLI at /plugin-data/bin/git-tools. arg_path/arg_digest default to the correct provisioned path and the sha256 of the binary's bytes; 'omit' passes an empty argv parameter, 'wrong' passes a valid-but-mismatched digest, and a literal overrides. bin_present=false withholds the binary so it cannot be re-hashed.",
  "cases": [
    {
      "name": "ordering-cp-abs-primary-target-from-outside-any-repo-cwd",
      "command": "cd /tmp && cp x /repo/tracked",
      "cwd": "/repo",
      "want_deny": true
    },
    {
      "name": "ordering-sed-i-abs-primary-target-from-outside-any-repo-cwd",
      "command": "cd /tmp && sed -i s/a/b/ /repo/f",
      "cwd": "/repo",
      "want_deny": true
    },
    {
      "name": "ordering-cp-abs-primary-target-from-worktree-cwd",
      "command": "cd /repo/wt && cp x /repo/tracked",
      "cwd": "/repo",
      "want_deny": true
    },
    {
      "name": "named-redirect-abs-primary-from-worktree-cwd",
      "command": "echo x>/repo/tracked",
      "cwd": "/repo/wt",
      "want_deny": true
    },
    {
      "name": "named-redirect-abs-primary-from-primary-cwd",
      "command": "echo x>/repo/tracked",
      "cwd": "/repo",
      "want_deny": true
    },
    {
      "name": "named-redirect-abs-primary-from-outside-any-repo-cwd",
      "command": "echo x>/repo/tracked",
      "cwd": "/tmp",
      "want_deny": true
    },
    {
      "name": "named-redirect-append-abs-primary-from-outside-any-repo-cwd",
      "command": "echo x>>/repo/tracked",
      "cwd": "/tmp",
      "want_deny": true
    },
    {
      "name": "named-redirect-glued-cd-then-redirect-into-primary",
      "command": "cd /repo>/repo/tracked",
      "cwd": "/tmp",
      "want_deny": true
    },
    {
      "name": "named-redirect-outanderr-dup-nonfd-abs-primary",
      "command": "echo x>&/repo/tracked",
      "cwd": "/tmp",
      "want_deny": true
    },
    {
      "name": "named-redirect-amp-append-abs-primary",
      "command": "echo x&>>/repo/tracked",
      "cwd": "/tmp",
      "want_deny": true
    },
    {
      "name": "named-redirect-fd2-dup-nonfd-abs-primary",
      "command": "echo x 2>&/repo/tracked",
      "cwd": "/tmp",
      "want_deny": true
    },
    {
      "name": "named-redirect-spaced-abs-primary-same-verdict-as-glued",
      "command": "echo x > /repo/tracked",
      "cwd": "/tmp",
      "want_deny": true
    },
    {
      "name": "named-redirect-abs-worktree-target-allowed",
      "command": "echo x>/repo/wt/tracked",
      "cwd": "/tmp",
      "want_deny": false
    },
    {
      "name": "named-redirect-append-abs-worktree-target-allowed",
